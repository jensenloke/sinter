{
  "name": "@jensenloke/sinter",
  "version": "0.1.10",
  "description": "Port and resume coding-agent sessions across harnesses.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jensenloke/sinter.git"
  },
  "homepage": "https://github.com/jensenloke/sinter#readme",
  "bugs": "https://github.com/jensenloke/sinter/issues",
  "keywords": [
    "coding-agent",
    "claude-code",
    "codex",
    "opencode",
    "session"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "type": "module",
  "bin": {
    "sinter": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@sinter/adapter-claude": "workspace:*",
    "@sinter/adapter-codex": "workspace:*",
    "@sinter/adapter-devin": "workspace:*",
    "@sinter/adapter-omp": "workspace:*",
    "@sinter/adapter-opencode": "workspace:*",
    "@sinter/adapter-pi": "workspace:*",
    "@sinter/adapter-zcode": "workspace:*",
    "@sinter/ledger": "workspace:*"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build"
  }
