{
  "name": "sinter-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:cli": "bun run --cwd packages/cli build",
    "verify:package": "bash scripts/verify-package.sh",
    "sinter": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "supabase": "^2.115.0",
    "typescript": "^5.6.0"
  }
}
